# Environment: local | staging | production
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
# Runtime provider selection: manus (current development runtime) | firebase (future integration)
WARDRO_RUNTIME_MODE=manus
WARDRO_MANUS_DEFAULT_USER=manus-user-a
WARDRO_MANUS_DEV_USERS=manus-user-a,manus-user-b,manus-admin
WARDRO_MANUS_DATA_DIR=/tmp/wardro-manus-runtime
WARDRO_MANUS_STORAGE_DIR=/tmp/wardro-manus-storage
# Optional development-only HMAC secret; never use a production credential here.
WARDRO_MANUS_STORAGE_SECRET=change-me-development-only

# Browser-safe Firebase Web API key used for admin sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Shared backend API. Leave empty when admin UI and API routes are deployed together.
NEXT_PUBLIC_API_BASE_URL=
# Backward-compatible alias used by older builds. Prefer NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_URL=

# Server-only Firebase Admin service account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"","client_email":"","private_key":""}
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# AI upstream. Mobile should call this backend at /api/ai; server forwards to this private upstream.
AI_API_BASE_URL=
AI_API_KEY=
AI_PROVIDER=
GEMINI_API_KEY=
VERTEX_AI_PROJECT_ID=

# Local demo mode only. Must be false/unset in production.
NEXT_PUBLIC_DEMO_MODE=false

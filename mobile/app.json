{
  "expo": {
    "name": "Tủ đồ của bạn",
    "slug": "tu-do-cua-ban",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tudocuaban",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tudocuaban.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F0EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.tudocuaban.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép truy cập ảnh để thêm quần áo vào tủ đồ."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép vị trí để gợi ý trang phục theo thời tiết."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

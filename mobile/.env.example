# Environment: local | staging | production
EXPO_PUBLIC_APP_ENV=local
# Current runtime provider: manus (Firebase-free development) | firebase (future integration)
EXPO_PUBLIC_WARDRO_RUNTIME_MODE=manus
EXPO_PUBLIC_WARDRO_MANUS_USER=manus-user-a
EXPO_PUBLIC_WARDRO_BUILD_SHA=development

# Shared backend API. In staging/prod this should point at the deployed admin/backend API host.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Backward-compatible alias used by older builds. Prefer EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Explicit local demo mode only. Must be false/unset in staging and production.
EXPO_PUBLIC_DEMO_MODE=false
# Keep this false when testing real login/register. Set true only for local UI demos
# where you want to skip Firebase Auth and enter the app as the bundled mock user.
EXPO_PUBLIC_DEMO_AUTH_BYPASS=false

# Firebase — copy to .env and fill from Firebase Console
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Social auth setup notes:
# - Enable Phone, Email/Password, Google, and Facebook providers in Firebase Authentication.
# - Google client IDs come from Google Cloud Console > APIs & Services > Credentials.
#   Use the Web client for Expo web/Firebase popup, iOS client for bundle
#   com.tudocuaban.app, and Android client for package com.tudocuaban.app + SHA keys.
# - Phone Auth on web uses Firebase reCAPTCHA. Native iOS/Android requires Firebase native
#   phone verification or a server OTP bridge.
# - Google/Facebook native sign-in requires provider app IDs/client IDs in app.json/EAS config.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=

# AI backend (Gemini / Vertex keys stay server-side)
EXPO_PUBLIC_ENABLE_REAL_AI=true
# Same backend host as EXPO_PUBLIC_API_BASE_URL plus /api/ai, unless using a dedicated AI gateway.
EXPO_PUBLIC_AI_API_BASE_URL=http://localhost:3000/api/ai

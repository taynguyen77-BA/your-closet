rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }
    function isActiveAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.status != 'disabled';
    }
    function adminRole() {
      return request.auth.token.adminRole != null
        ? request.auth.token.adminRole
        : get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role;
    }
    function hasAnyRole(roles) {
      return isActiveAdmin() && adminRole() in roles;
    }
    function ownsExisting() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    function preservesOwner() {
      return request.resource.data.userId == resource.data.userId;
    }
    function usesSupportedConsumerAuthProvider() {
      return request.auth.token.firebase.sign_in_provider in ['phone', 'google.com', 'facebook.com'] &&
        request.resource.data.authProvider in ['phone', 'google', 'facebook'] &&
        request.resource.data.provider in ['phone', 'google', 'facebook'];
    }
    function isActivePublicResource() {
      return !('status' in resource.data) || resource.data.status == 'active' || resource.data.isActive == true;
    }
    function isPublishedPublicResource() {
      return resource.data.status == 'published';
    }
    function isApprovedPublicResource() {
      return resource.data.status == 'approved';
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.id == userId &&
        request.resource.data.plan == 'free' &&
        usesSupportedConsumerAuthProvider();
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'username', 'avatarUrl', 'phoneNumber', 'gender', 'dateOfBirth',
          'fashionStyle', 'preferences', 'favoriteColors', 'fashionGoals', 'biometricEnabled',
          'hasCompletedOnboarding', 'hasCompletedStyleSurvey', 'styleSurveySkipped',
          'styleSurveyCompletedAt', 'styleProfileCompletionPercent', 'stylePreferences',
          'advancedStylePreferences', 'styleProfileRewardClaimed', 'lastLoginAt', 'updatedAt'
        ]);
      allow read: if hasAnyRole(['super_admin', 'support']);
      allow write: if isActiveAdmin();
    }
    match /adminUsers/{adminUserId} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if hasAnyRole(['super_admin']);
    }
    match /clothes/{itemId} {
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && preservesOwner();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    match /outfits/{outfitId} {
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && preservesOwner();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    match /events/{eventId} {
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && preservesOwner();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    match /missions/{missionId} {
      allow read: if isActivePublicResource() || request.auth != null;
      allow write: if hasAnyRole(['super_admin', 'content_manager']);
    }
    match /plan_limits/{planId} {
      allow read: if isActivePublicResource() || request.auth != null;
      allow write: if hasAnyRole(['super_admin', 'finance']);
    }
    match /user_missions/{progressId} {
      allow read: if ownsExisting();
      allow write: if isActiveAdmin();
    }
    match /listings/{listingId} {
      allow read: if isApprovedPublicResource() || isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == 'pending_review';
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == resource.data.status;
      allow update: if hasAnyRole(['super_admin', 'moderator']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /transactions/{txId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId &&
        request.resource.data.status == 'pending';
      allow update: if false;
      allow update, delete: if hasAnyRole(['super_admin', 'finance', 'support']);
    }
    match /marketplace_messages/{messageId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.sellerId);
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.sellerId);
    }
    match /trade_offers/{offerId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId;
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId) &&
        request.resource.data.buyerId == resource.data.buyerId &&
        request.resource.data.sellerId == resource.data.sellerId;
    }
    match /listing_reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId;
      allow read: if request.auth != null && request.auth.uid == resource.data.reporterId || isActiveAdmin();
      allow update: if hasAnyRole(['super_admin', 'moderator', 'support']);
    }
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if isActiveAdmin();
    }
    match /ai_logs/{logId} {
      // Authoritative AI usage records are written only by the trusted server via Admin SDK.
      allow create, update, delete: if false;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow read: if isActiveAdmin();
    }
    match /admin_settings/{settingId} {
      allow read, write: if hasAnyRole(['super_admin']);
    }
    match /subscriptions/{id} {
      allow read, write: if hasAnyRole(['super_admin', 'finance']);
    }
    match /trends/{trendId} {
      allow read: if isPublishedPublicResource() || request.auth != null;
      allow write: if hasAnyRole(['super_admin', 'content_manager']);
    }
    match /affiliate_products/{productId} {
      allow read: if isActivePublicResource() || request.auth != null;
      allow write: if hasAnyRole(['super_admin', 'content_manager']);
    }
    match /cms_content/{contentId} {
      allow read: if isPublishedPublicResource() || request.auth != null;
      allow write: if hasAnyRole(['super_admin', 'content_manager', 'support']);
    }
    match /reports/{id} {
      allow read, write: if isActiveAdmin();
    }
    match /notification_templates/{id} {
      allow read, write: if hasAnyRole(['super_admin', 'content_manager', 'support']);
    }
    match /admin_logs/{id} {
      allow read, write: if hasAnyRole(['super_admin']);
    }
    match /security_logs/{id} {
      allow read, write: if hasAnyRole(['super_admin', 'support']);
    }
  }
}
